{
  "name": "broccoli-babel-transpiler",
  "version": "8.1.0",
  "description": "A Broccoli plugin which transpile ES6 to readable ES5 by using babel.",
  "keywords": [
    "broccoli-plugin",
    "transpiler",
    "es6",
    "ecmascript",
    "ecmascript6",
    "harmony",
    "javascript",
    "js"
  ],
  "homepage": "https://github.com/ember-cli/broccoli-babel-transpiler",
  "bugs": {
    "url": "https://github.com/ember-cli/broccoli-babel-transpiler/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ember-cli/broccoli-babel-transpiler.git"
  },
  "license": "MIT",
  "author": "nightire <nightire@very-geek.com> (http://very-geek.com/)",
  "main": "index.js",
  "files": [
    "index.js",
    "lib"
  ],
  "scripts": {
    "changelog": "lerna-changelog",
    "test": "mocha tests/test.js",
    "test:all": "mocha tests/test.js tests/test-slow.js",
    "test:babel-8": "npm run use-babel-8 && npm test",
    "test:debug": "mocha debug tests/test.js",
    "test:slow": "mocha tests/test-slow.js",
    "test:slow:debug": "mocha debug tests/test-slow.js",
    "use-babel-8": "npm install --no-save --no-package-lock @babel/core@^8.0.0 @babel/plugin-transform-block-scoping@^8.0.0 @babel/plugin-transform-classes@^8.0.0 @babel/plugin-transform-modules-amd@^8.0.0 @babel/plugin-transform-strict-mode@^8.0.0"
  },
  "dependencies": {
    "broccoli-persistent-filter": "^3.0.0",
    "clone": "^2.1.2",
    "hash-for-dep": "^1.4.7",
    "heimdalljs": "^0.2.1",
    "heimdalljs-logger": "^0.1.9",
    "json-stable-stringify": "^1.0.1",
    "rsvp": "^4.8.4",
    "workerpool": "^6.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.17.9",
    "@babel/plugin-transform-block-scoping": "^7.16.7",
    "@babel/plugin-transform-classes": "^7.16.7",
    "@babel/plugin-transform-modules-amd": "^7.16.7",
    "@babel/plugin-transform-strict-mode": "^7.16.7",
    "amd-name-resolver": "1.3.1",
    "babel-plugin-module-resolver": "^4.1.0",
    "broccoli-test-helpers": "0.0.9",
    "chai": "^4.2.0",
    "fixturify-project": "^1.9.0",
    "mkdirp": "^0.5.1",
    "mocha": "^6.0.1",
    "ps-node": "^0.1.6",
    "release-plan": "^0.18.0"
  },
  "peerDependencies": {
    "@babel/core": "^7.17.9 || ^8.0.0"
  },
  "packageManager": "npm@9.9.4+sha256.640bdd76a0b9d92e9da6e391abae75fd2f168478e416847f3acdb8373737e0ee",
  "engines": {
    "node": "16.* || >= 18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
